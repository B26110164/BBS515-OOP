public class Arac {
    
    //Instance Variables
    String marka;
    String model;
    double gunlukUcret;
    boolean kiradaMi;
    public Arac(String marka, String model, double gunlukUcret, boolean kiradaMi)
    {
        this.marka = marka;
        this.model = model;
        this.gunlukUcret = gunlukUcret;
        this.kiradaMi = kiradaMi;
    }

    void bilgileriGoster() {
        
        System.out.println("Marka : "+ this.marka);
        System.out.println("Model : "+ this.model);
        System.out.println("Günlük Ücret: "+ this.gunlukUcret);
        String durum = this.kiradaMi?"Kirada":"Müsait";
        System.out.println("Durum : "+ durum);
        for (int i=0; i<19; i++)
            System.out.print("-");
        System.out.print("\n");
    }
    void kirala() {
        if(!kiradaMi){
            System.out.println(this.marka + " " + this.model + " başarıyla kiralandı.");
            kiradaMi=true;
        } else {
            System.out.println("Bu araç zaten kiralanmış.");
        }
    }
    void teslimEt() {
        if(kiradaMi) {
            System.out.println(this.marka + " " + this.model + " başarıyla teslim alındı.");
            kiradaMi = false;
        } else {
            System.out.println("Bu araç zaten teslim alınmış.");
        }
    }
    double kiraBedeliHesapla(int gun) {
        return this.gunlukUcret*gun;
    }
}